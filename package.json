{
  "name": "antigravity-mission-board",
  "version": "2.1.0",
  "private": true,
  "description": "Local Kanban & Mission Control desktop app for Google Antigravity Desktop 2.0",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "setup": "npm --prefix server install && npm --prefix web install",
    "setup:desktop": "npm --prefix desktop install",
    "dev": "node server/scripts/dev-all.mjs",
    "dev:demo": "node server/scripts/dev-all.mjs --demo",
    "dev:server": "npm --prefix server run dev",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix server run build && npm --prefix web run build",
    "start": "npm --prefix server run start",
    "start:demo": "npm --prefix server run start:demo",
    "desktop": "npm --prefix desktop start",
    "desktop:demo": "npm --prefix desktop run start:demo",
    "desktop:install": "npm --prefix desktop run install:shortcut",
    "desktop:uninstall": "npm --prefix desktop run uninstall:shortcut",
    "desktop:dist": "npm --prefix desktop run dist",
    "desktop:check": "npm --prefix desktop run check",
    "test": "npm --prefix server test",
    "typecheck": "npm --prefix server run typecheck && npm --prefix web run typecheck"
  }
}
