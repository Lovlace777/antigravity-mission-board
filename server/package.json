{
  "name": "antigravity-mission-board-server",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:demo": "tsx watch src/index.ts --demo",
    "build": "tsc -p tsconfig.json",
    "start": "node --no-warnings=ExperimentalWarning dist/server/src/index.js",
    "start:demo": "node --no-warnings=ExperimentalWarning dist/server/src/index.js --demo",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
